      <Item class="LocalScript" referent="UIVADMIN_Controller">
        <Properties>
          <string name="Name">LickUIverseAdmin</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- UIverse Admin visuals bridged to the LickLand owner-verified server admin.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local player=Players.LocalPlayer
local gui=script.Parent
local remotes=ReplicatedStorage:WaitForChild("LickRemotes")
local adminInfo=remotes:WaitForChild("AdminInfo")
local adminAction=remotes:WaitForChild("AdminAction")
local button=gui:WaitForChild("AdminButton")
local panel=gui:WaitForChild("Panel")
local msg=gui:WaitForChild("MessageCard")
button.Visible=false; panel.Visible=false; msg.Visible=false
local function hit(parent)
 return parent and parent:FindFirstChild("HitTarget")
end
local function say(title,body)
 msg.Visible=true
 local h=msg:FindFirstChild("Header")
 if h then
  local t=h:FindFirstChild("Title"); if t then t.Text=title end
 end
 local b=msg:FindFirstChild("Body"); if b then b.Text=tostring(body or "") end
end
local close=panel:FindFirstChild("Header") and panel.Header:FindFirstChild("CloseButton")
local closeHit=hit(close)
if closeHit then closeHit.Activated:Connect(function() panel.Visible=false end) end
local okHit=msg:FindFirstChild("OkButton") and hit(msg.OkButton)
if okHit then okHit.Activated:Connect(function() msg.Visible=false end) end
local openHit=hit(button)
if openHit then openHit.Activated:Connect(function() panel.Visible=not panel.Visible end) end
local function findTarget(value)
 if not value or value=="" then return nil end
 local num=tonumber(value)
 if num then return num end
 local low=string.lower(value)
 for _,p in ipairs(Players:GetPlayers()) do
  if string.lower(p.Name)==low or string.lower(p.DisplayName)==low then return p.UserId end
 end
 for _,p in ipairs(Players:GetPlayers()) do
  if string.sub(string.lower(p.Name),1,#low)==low then return p.UserId end
 end
 return nil
end
local function execute()
 local bar=panel:WaitForChild("CommandBar")
 local input=bar:WaitForChild("Input")
 local line=input.Text
 local cmd,rest=string.match(line,"^(%S+)%s*(.-)%s*$")
 if not cmd then say("ADMIN","Enter a command."); return end
 cmd=string.lower(cmd)
 if cmd=="announce" then
  local ok,a,b=pcall(function() return adminAction:InvokeServer(cmd,nil,rest) end)
  say(ok and (a and "SUCCESS" or "ADMIN") or "ERROR",ok and b or "Admin service unavailable."); return
 end
 if cmd=="stats" then
  local ok,a,b=pcall(function() return adminAction:InvokeServer(cmd) end)
  say(ok and (a and "SERVER STATS" or "ADMIN") or "ERROR",ok and b or "Admin service unavailable."); return
 end
 local target,arg=string.match(rest,"^(%S+)%s*(.-)%s*$")
 local id=findTarget(target)
 if not id then say("ADMIN","Player not found. Use the username or user ID of someone in this server."); return end
 local ok,a,b=pcall(function() return adminAction:InvokeServer(cmd,id,arg) end)
 say(ok and (a and "SUCCESS" or "ADMIN") or "ERROR",ok and b or "Admin service unavailable.")
end
local run=panel:WaitForChild("RunButton")
local runHit=hit(run)
if runHit then runHit.Activated:Connect(execute) end
local input=panel.CommandBar.Input
input.FocusLost:Connect(function(enter) if enter then execute() end end)
input.PlaceholderText="cash player 1000 | level player 10 | stats | announce message"
local title=panel.Header:FindFirstChild("Title"); if title then title.Text="LICKLAND ADMIN" end
local role=panel.Header:FindFirstChild("RoleBadge")
if role then
 local r=role:FindFirstChildWhichIsA("TextLabel",true)
 if r then r.Text="OWNER" end
end
-- Hide unused HD Admin pages; the actual LickLand command box remains functional.
local main=panel:FindFirstChild("Main")
if main then
 for _,page in ipairs(main:GetChildren()) do
  if page:IsA("Frame") then page.Visible=(page.Name=="HomePage") end
 end
 local home=main:FindFirstChild("HomePage")
 if home then
  for _,obj in ipairs(home:GetDescendants()) do
   if obj:IsA("TextLabel") and obj.Text~="" then
    if obj.Name=="Title" then obj.Text="LickLand Owner Console" end
   end
  end
 end
end
local authorized=false
for attempt=1,12 do
 local ok,info=pcall(function() return adminInfo:InvokeServer() end)
 if ok and type(info)=="table" and info.admin==true and player.UserId==8157356300 then
  authorized=true; break
 end
 task.wait(1)
end
button.Visible=authorized
if not authorized then panel.Visible=false end
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>