local hl = Instance.new("Highlight")
hl.OutlineColor = Color3.fromRGB(255, 235, 60)
hl.FillColor = Color3.fromRGB(255, 110, 190)
hl.FillTransparency = 0.6
hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
hl.Enabled = false
hl.Parent = gfx
local anchorPart = Instance.new("Part")
anchorPart.Anchored, anchorPart.CanCollide, anchorPart.CanQuery, anchorPart.CanTouch, anchorPart.Transparency = true, false, false, false, 1
anchorPart.Size = Vector3.new(1, 1, 1)
anchorPart.Parent = gfx
bb.Adornee = anchorPart

local target = nil -- Vector3 the arrows point to
local function hide3d()
	target = nil
	hl.Enabled = false
	hl.Adornee = nil
	bb.Enabled = false
	beacon.Transparency = 1
	for _, pair in ipairs(chev) do pair[1].Transparency, pair[2].Transparency = 1, 1 end
end
local function setModel(m)
	if not m then hide3d() return end
	local c = m:GetAttribute("Center") or m:GetPivot().Position
	target = Vector3.new(c.X, 0, c.Z)
	hl.Adornee = m
	hl.Enabled = true
	anchorPart.Position = c + Vector3.new(0, (m:GetAttribute("Radius") or 3) + 5, 0)
	bb.Enabled = true
	beacon.CFrame = CFrame.new(c.X, 35, c.Z) * CFrame.Angles(0, 0, math.rad(90))
	beacon.Transparency = 0.7
end
local function setPos(v)
	target = Vector3.new(v.X, 0, v.Z)
	hl.Enabled = false
	anchorPart.Position = v + Vector3.new(0, 14, 0)
	bb.Enabled = true
	beacon.CFrame = CFrame.new(v.X, 35, v.Z) * CFrame.Angles(0, 0, math.rad(90))
	beacon.Transparency = 0.7
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	if bb.Enabled then
		bb.StudsOffset = Vector3.new(0, math.sin(t * 4) * 1.2, 0)
	end
	if beacon.Transparency &lt; 1 then beacon.Transparency = 0.65 + 0.12 * math.sin(t * 3) end
	local p = myPos()
	if not target or not p then return end
	local from = Vector3.new(p.X, p.Y - 2.8, p.Z)
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local dist = flat.Magnitude
	if dist &lt; 9 then
		for _, pair in ipairs(chev) do pair[1].Transparency, pair[2].Transparency = 1, 1 end
		return
	end
	local dir = flat.Unit
	local flow = (t * 9) % 5
	for i, pair in ipairs(chev) do
		local d = 5 + (i - 1) * 5 + flow
		if d &lt; dist - 4 and d &lt; 90 then
			local pos = from + dir * d
			local base = CFrame.lookAt(pos, pos + dir)
			local fade = math.clamp(1 - d / 90, 0.1, 1)
			pair[1].CFrame = base * CFrame.new(-0.95, 0, 0.55) * CFrame.Angles(0, math.rad(40), 0)
			pair[2].CFrame = base * CFrame.new(0.95, 0, 0.55) * CFrame.Angles(0, math.rad(-40), 0)
			pair[1].Transparency, pair[2].Transparency = 1 - fade * 0.9, 1 - fade * 0.9
		else
			pair[1].Transparency, pair[2].Transparency = 1, 1
		end
	end
end)

local pointer
local function clearPointer()
	if pointer then pointer:Destroy() pointer = nil end
end
local function pointAt(name)
	clearPointer()
	local h = root:FindFirstChild(name, true)
	if not h then return end
	pointer = Instance.new("Frame")
	pointer.BackgroundTransparency = 1
	pointer.Size = UDim2.new(1.3, 0, 1.3, 0)
	pointer.Position = UDim2.new(-0.15, 0, -0.15, 0)
	pointer.ZIndex = 25
	pointer.Parent = h
	corner(pointer, 24)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(255, 235, 60)
	s.Thickness = 6
	s.Parent = pointer
	TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 2 }):Play()
	local a = text(pointer, "v", UDim2.new(0, 44, 0, 40), UDim2.new(0.5, -22, 0, -46), 40, Color3.fromRGB(255, 235, 60))
	a.ZIndex = 26
end

local fxLayer = Instance.new("Frame")
fxLayer.BackgroundTransparency = 1
fxLayer.Size = UDim2.new(1, 0, 1, 0)
fxLayer.ZIndex = 28
fxLayer.Parent = root
local card = box(fxLayer, UDim2.new(0, 400, 0, 124), UDim2.new(0.5, -200, 0, 122), BLUE1, BLUE2, 16, true)
card.ZIndex = 29
card.Visible = false
local dots = {}
for i = 1, 6 do
	local d = box(card, UDim2.new(0, 14, 0, 14), UDim2.new(0, 14 + (i - 1) * 20, 0, 8), WHITE, WHITE, 7)
	dots[i] = d
end
local titleL = text(card, "", UDim2.new(1, -20, 0, 34), UDim2.new(0, 10, 0, 24), 28, YELLOW1, Enum.TextXAlignment.Left)
local bodyL = text(card, "", UDim2.new(1, -20, 0, 50), UDim2.new(0, 10, 0, 58), 16, WHITE, Enum.TextXAlignment.Left)
bodyL.TextWrapped = true
bodyL.TextYAlignment = Enum.TextYAlignment.Top
local skipB, skipH = button(fxLayer, "SKIP TUTORIAL", UDim2.new(0, 190, 0, 40), UDim2.new(1, -214, 0, 98), RED1, RED2, 17)
skipH.ZIndex = 30

local alive = true
local function cleanup()
	alive = false
	hide3d()
	clearPointer()
	fxLayer:Destroy()
	gfx:Destroy()
end
skipB.Activated:Connect(function()
	remotes.TutorialAction:FireServer("skip")
	cleanup()
end)

local function confetti(n)
	for i = 1, n do
		local c = Instance.new("Frame")
		c.Size = UDim2.new(0, math.random(8, 16), 0, 10)
		c.Position = UDim2.new(math.random(), 0, -0.05, 0)
		c.Rotation = math.random(0, 360)
		c.BackgroundColor3 = Color3.fromHSV(math.random(), 0.7, 1)
		c.BorderSizePixel = 0
		c.ZIndex = 40
		c.Parent = root
		local tw = TweenService:Create(c, TweenInfo.new(1.3 + math.random(), Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(c.Position.X.Scale, 0, 1.1, 0), Rotation = c.Rotation + 300 })
		tw:Play()
		tw.Completed:Connect(function() c:Destroy() end)
	end
end

local GATE = Vector3.new(-320, 3, -160)
local steps = {
	{ "LICK THE DONUT!", "Walk to the glowing donut. Tap it, or hold the LICK button, until it is gone!", function() return "model", starter() end, function() return foods &gt;= 1 end },
	{ "COLLECT FOOD!", "Lick food to fill your inventory. Visit the Sell Shop to turn it into Cash, then buy upgrades.", function() return "model", nearestFood() end, function() return stats.Cash.Value &gt;= COSTS[1] end },
	{ "LEVEL UP!", "Tap +1 LEVEL to make your tongue stronger. Levels unlock new zones!", function() return "gui", "Btn_buy1" end, function() return stats.Tongue.Value &gt;= 2 end },
	{ "UNLOCK ZONES!", "Walk to the glowing gate. At Level 10 it opens the " .. ZN[2] .. ". Higher zones pay more cash!", function() return "pos", GATE end, function() local p = myPos() return p and (Vector3.new(GATE.X, p.Y, GATE.Z) - p).Magnitude &lt; 50 end },
	{ "VISIT THE SHOP!", "Tap the shopkeeper to upgrade your speed and roll for tongue skins.", function() return "model", shopNpc() end, function() return shopOpened end },
	{ "REBIRTH!", "At Level 100 you can REBIRTH: reset your level for permanent cash bonuses. Tap Rebirth to read how it works.", function() return "gui", "Btn_rebirth" end, function() return rebirthOpened end },
}

local function show(i)
	local s = steps[i]
	card.Visible = true
	titleL.Text = s[1]
	bodyL.Text = s[2]
	popIn(card)
	for k = 1, 6 do dots[k].BackgroundColor3 = k &lt; i and GREEN1 or (k == i and YELLOW1 or Color3.fromRGB(190, 190, 230)) end
	remotes.TutorialAction:FireServer("step", i)
	clearPointer()
	hide3d()
end

local function welcome()
	local white = Instance.new("Frame")
	white.Size = UDim2.new(1, 0, 1, 0)
	white.BackgroundColor3 = WHITE
	white.BorderSizePixel = 0
	white.ZIndex = 45
	white.Parent = root
	TweenService:Create(white, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
	task.delay(1, function() white:Destroy() end)
	local t = text(root, "WELCOME TO LICK LAND!", UDim2.new(0, 560, 0, 70), UDim2.new(0.5, -280, -0.2, 0), 52)
	t.ZIndex = 46
	t.TextScaled = true
	gradient(t, Color3.fromRGB(255, 250, 140), Color3.fromRGB(255, 130, 200))
	TweenService:Create(t, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -280, 0.2, 0) }):Play()
	sfx("chime", 1.2, 1)
	confetti(36)
	local s = text(root, "Lick food. Sell your haul. Spend Cash. Unlock new worlds!", UDim2.new(0, 560, 0, 30), UDim2.new(0.5, -280, 0.2, 76), 22)
	s.ZIndex = 46
	task.wait(2.2)
	TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.wait(0.4)
	t:Destroy()
	s:Destroy()
end

task.spawn(function()
	local i = math.clamp(tut.step or 1, 1, #steps)
	if not tut.step then
		remotes.TutorialAction:FireServer("step", 1)
		task.spawn(welcome)
		task.wait(1.4) -- the arrow and glowing target appear while the welcome title is still on screen
	end
	show(i)
	while alive and i &lt;= #steps do
		local s = steps[i]
		local kind, val = s[3]()
		if kind == "model" then setModel(val) elseif kind == "pos" then setPos(val) elseif kind == "gui" then if not pointer or pointer.Parent == nil then pointAt(val) end end
		if s[4]() then
			sfx("chime", 1.2, 0.9)
			confetti(12)
			if i == #steps then break end
			i = i + 1
			show(i)
		end
		task.wait(0.25)
	end
	if alive then
		remotes.TutorialAction:FireServer("done")
		hide3d()
		clearPointer()
		sfx("chime", 1.5, 1)
		confetti(50)
		titleL.Text = "TUTORIAL COMPLETE!"
		bodyL.Text = "Reward added. Have fun licking!"
		for k = 1, 6 do dots[k].BackgroundColor3 = GREEN1 end
		task.wait(3)
		cleanup()
	end
end)
print("[LickTutorial] ready")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX41">
        <Properties>
          <string name="Name">LickLoading</string>
          <ProtectedString name="Source">-- LICK LOADING (LocalScript)  Location: StarterPlayer &gt; StarterPlayerScripts &gt; LickLoading
-- Covers the initial spawn until the player's save and core HUD are ready.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function sinkInput()
    return Enum.ContextActionResult.Sink
end
pcall(function()
    ContextActionService:BindActionAtPriority("LickLandLoadingLock", sinkInput, false, 3000,
        Enum.PlayerActions.CharacterForward, Enum.PlayerActions.CharacterBackward,
        Enum.PlayerActions.CharacterLeft, Enum.PlayerActions.CharacterRight,
        Enum.PlayerActions.CharacterJump)
end)

local controls
pcall(function()
    local scripts = player:WaitForChild("PlayerScripts", 12)
    local moduleScript = scripts and scripts:WaitForChild("PlayerModule", 12)
    if moduleScript then
        local module = require(moduleScript)
        controls = module:GetControls()
        controls:Disable()
    end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "LickLoading"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 10000
gui.Parent = playerGui
local cover = Instance.new("Frame")
cover.Size = UDim2.fromScale(1, 1)
cover.BackgroundColor3 = Color3.fromRGB(19, 13, 49)
cover.BorderSizePixel = 0
cover.Parent = gui
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(32, 18, 75)),
    ColorSequenceKeypoint.new(0.52, Color3.fromRGB(89, 35, 126)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 30, 82))
})
gradient.Rotation = 35
gradient.Parent = cover
local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.42)
title.Size = UDim2.new(0.9, 0, 0, 90)
title.Font = Enum.Font.FredokaOne
title.Text = "LICKLAND"
title.TextColor3 = Color3.fromRGB(255, 125, 205)
title.TextStrokeColor3 = Color3.fromRGB(8, 8, 30)
title.TextStrokeTransparency = 0
title.TextScaled = true
title.Parent = cover
local subtitle = Instance.new("TextLabel")
subtitle.BackgroundTransparency = 1
subtitle.AnchorPoint = Vector2.new(0.5, 0.5)
subtitle.Position = UDim2.fromScale(0.5, 0.53)
subtitle.Size = UDim2.new(0.85, 0, 0, 36)
subtitle.Font = Enum.Font.GothamBold
subtitle.Text = "LOADING YOUR PROGRESS..."
subtitle.TextColor3 = Color3.fromRGB(255, 245, 255)
subtitle.TextScaled = true
subtitle.Parent = cover
local track = Instance.new("Frame")
track.AnchorPoint = Vector2.new(0.5, 0.5)
track.Position = UDim2.fromScale(0.5, 0.63)
track.Size = UDim2.new(0.62, 0, 0, 13)
track.BackgroundColor3 = Color3.fromRGB(9, 8, 30)
track.BorderSizePixel = 0
track.Parent = cover
local trackCorner = Instance.new("UICorner")
trackCorner.CornerRadius = UDim.new(1, 0)
trackCorner.Parent = track
local fill = Instance.new("Frame")
fill.Size = UDim2.new(0.08, 0, 1, 0)
fill.BackgroundColor3 = Color3.fromRGB(255, 220, 90)
fill.BorderSizePixel = 0
fill.Parent = track
local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(1, 0)
fillCorner.Parent = fill
TweenService:Create(fill, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = UDim2.new(0.82, 0, 1, 0) }):Play()

local function waitUntilReady()
    while player.Parent and player:GetAttribute("DataReady") ~= true do
        task.wait(0.15)
    end
    if not player.Parent then return false end
    local character = player.Character or player.CharacterAdded:Wait()
    if character then character:WaitForChild("HumanoidRootPart", 15) end
    local ui = playerGui:WaitForChild("LickUI", 25)
    if ui then ui:WaitForChild("Root", 15) end
    return true
end

if waitUntilReady() then
    subtitle.Text = "WELCOME TO LICKLAND!"
    pcall(function() ContextActionService:UnbindAction("LickLandLoadingLock") end)
    if controls then pcall(function() controls:Enable() end) end
    TweenService:Create(cover, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
    for _, object in ipairs(cover:GetDescendants()) do
        if object:IsA("TextLabel") then
            TweenService:Create(object, TweenInfo.new(0.65), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
        elseif object:IsA("Frame") then
            TweenService:Create(object, TweenInfo.new(0.65), { BackgroundTransparency = 1 }):Play()
        end
    end
    task.wait(0.85)
    gui:Destroy()
end
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX_NEW_LickIntro">
        <Properties>
          <string name="Name">LickIntro</string>
          <bool name="Disabled">false</bool>
          <bool name="Archivable">true</bool>
          <ProtectedString name="Source">-- LickLand first-join cinematic + replay support
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local player=Players.LocalPlayer
local replay=Instance.new("BindableEvent"); replay.Name="LickIntroReplay"; replay.Parent=ReplicatedStorage
local busy=false
local function playIntro()
    if busy then return end
    local char=player.Character or player.CharacterAdded:Wait()
    local root=char:WaitForChild("HumanoidRootPart",8)
    local hum=char:FindFirstChildOfClass("Humanoid")
    local camera=workspace.CurrentCamera
    if not root or not camera then return end
    busy=true
    local oldType=camera.CameraType
    local oldSubject=camera.CameraSubject
    local gui=Instance.new("ScreenGui"); gui.Name="LickIntroCinematic"; gui.IgnoreGuiInset=true
    gui.ResetOnSpawn=false; gui.DisplayOrder=10000; gui.Parent=player:WaitForChild("PlayerGui")
    local shade=Instance.new("Frame"); shade.Size=UDim2.fromScale(1,1); shade.BackgroundColor3=Color3.fromRGB(15,8,35)
    shade.BackgroundTransparency=1; shade.Parent=gui
    local logo=Instance.new("TextLabel"); logo.AnchorPoint=Vector2.new(.5,.5); logo.Position=UDim2.fromScale(.5,.25)
    logo.Size=UDim2.new(.9,0,0,90); logo.BackgroundTransparency=1; logo.Text="LICKLAND"
    logo.Font=Enum.Font.FredokaOne; logo.TextScaled=true; logo.TextColor3=Color3.fromRGB(255,220,90)
    logo.TextStrokeColor3=Color3.fromRGB(50,25,75); logo.TextStrokeTransparency=0; logo.TextTransparency=1; logo.Parent=shade
    local skip=Instance.new("TextButton"); skip.AnchorPoint=Vector2.new(1,1); skip.Position=UDim2.new(1,-22,1,-22)
    skip.Size=UDim2.new(0,110,0,44); skip.BackgroundColor3=Color3.fromRGB(255,190,65)
    skip.Text="SKIP"; skip.Font=Enum.Font.FredokaOne; skip.TextScaled=true; skip.TextColor3=Color3.fromRGB(55,35,75)
    skip.Parent=shade; local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,12); c.Parent=skip
    local skipped=false; skip.Activated:Connect(function() skipped=true end)
    camera.CameraType=Enum.CameraType.Scriptable
    local center=root.Position
    local from=CFrame.lookAt(center+Vector3.new(0,22,42),center+Vector3.new(0,3,0))
    local mid=CFrame.lookAt(center+Vector3.new(32,13,24),center+Vector3.new(0,3,0))
    local finish=CFrame.lookAt(center+Vector3.new(0,8,18),center+Vector3.new(0,3,0))
    camera.CFrame=from
    TweenService:Create(shade,TweenInfo.new(.5),{BackgroundTransparency=0.18}):Play()
    TweenService:Create(logo,TweenInfo.new(.7),{TextTransparency=0}):Play()
    local t1=TweenService:Create(camera,TweenInfo.new(2.2,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{CFrame=mid})
    t1:Play()
    local started=os.clock()
    while os.clock()-started&lt;2.25 and not skipped do task.wait(.05) end
    if skipped then t1:Cancel() end
    if not skipped then
        local t2=TweenService:Create(camera,TweenInfo.new(1.8,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=finish})
        t2:Play()
        local t=os.clock(); while os.clock()-t&lt;1.85 and not skipped do task.wait(.05) end
        if skipped then t2:Cancel() end
    end
    TweenService:Create(shade,TweenInfo.new(.45),{BackgroundTransparency=1}):Play()
    TweenService:Create(logo,TweenInfo.new(.3),{TextTransparency=1}):Play()
    task.wait(.5)
    camera.CameraType=oldType
    if hum then camera.CameraSubject=hum elseif oldSubject then camera.CameraSubject=oldSubject end
    gui:Destroy()
    if not player:WaitForChild("LickState"):WaitForChild("IntroSeen").Value then
        ReplicatedStorage:WaitForChild("LickRemotes"):WaitForChild("MarkIntroSeen"):FireServer()
    end
    busy=false
end
task.spawn(function()
    repeat task.wait(.15) until player:GetAttribute("DataReady") == true
    local seen=player:WaitForChild("LickState"):WaitForChild("IntroSeen")
    if not seen.Value then task.wait(1.2); playIntro() end
end)
replay.Event:Connect(playIntro)
