    <Item class="Folder" referent="RBX38">
      <Properties>
        <string name="Name">LickLand_Import_Notes</string>
      </Properties>
      <Item class="StringValue" referent="RBX39">
        <Properties>
          <string name="Name">READ_ME</string>
          <string name="Value">Owner UserId configured in LickAdmin.lua: 8157356300. Server scripts are in ServerScriptService; client LocalScripts are in StarterPlayer &gt; StarterPlayerScripts.</string>
        </Properties>
      </Item>
      <Item class="StringValue" referent="RBX_LICK_README">
        <Properties>
          <string name="Name">READ_ME</string>
          <string name="Value">LickLand full place. Server gameplay/data/economy scripts are in ServerScriptService. Client HUD, panels, tutorial, loading, intro and sell-shop controllers are in StarterGui &gt; LickClientUIControllers. Character/input/audio/render systems remain in StarterPlayerScripts. UIverse source models are supplied alongside this place in the companion package; import/adapt their visual components in Studio without installing duplicate economy, admin frameworks or receipt handlers. Roblox runtime testing is still required.</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX_SG_01">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="RBX_LICK_UIROOT">
      <Properties>
        <string name="Name">LickClientUIControllers</string>
        <bool name="ResetOnSpawn">false</bool>
        <bool name="IgnoreGuiInset">true</bool>
        <int name="DisplayOrder">1</int>
      </Properties>
      <Item class="LocalScript" referent="RBX25">
        <Properties>
          <string name="Name">LickUI</string>
          <ProtectedString name="Source">-- Compatibility anchor only. The visible interface is the UIverse MainHUD.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local player=Players.LocalPlayer
local pg=player:WaitForChild("PlayerGui")
local gui=pg:FindFirstChild("LickUI")
if not gui then
