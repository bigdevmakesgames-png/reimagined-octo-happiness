      <Item class="LocalScript" referent="UIVHUD_Controller">
        <Properties>
          <string name="Name">LickUIverseController</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source">-- UIverse HUD bridge for LickLand. Uses the supplied UIverse visuals and LickLand remotes only.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local hud = script.Parent
local remotes = ReplicatedStorage:WaitForChild("LickRemotes")
local left = hud:WaitForChild("LeftMenu")
local windows = hud:WaitForChild("Windows")
local cashCounter = hud:WaitForChild("CashCounter")
local foodCounter = hud:WaitForChild("FoodCounter")
local toast = hud:WaitForChild("Toast")
local toastMessage = toast:WaitForChild("Message")
local shop = hud:WaitForChild("ShopMenu")
local settings = hud:WaitForChild("Settings")
local state = player:WaitForChild("LickState")
local stats = player:WaitForChild("leaderstats")
local cash = stats:WaitForChild("Cash")
local inventory = state:WaitForChild("FoodInventory")
local capacity = state:FindFirstChild("FoodCapacity")
local function fmt(n)
 n=math.floor(tonumber(n) or 0); if n&lt;1000 then return tostring(n) end
 local suffix={"K","M","B","T","Qa","Qi"}; local i=0
 while n&gt;=1000 and i&lt;#suffix do n=n/1000; i=i+1 end
 return string.format(n&lt;10 and "%.2f%s" or n&lt;100 and "%.1f%s" or "%.0f%s",n,suffix[i])
end
local function showToast(msg)
 toastMessage.Text=tostring(msg or "")
 toast.Visible=true
 local sc=toast:FindFirstChild("ToastScale")
 if sc then sc.Scale=0.85; TweenService:Create(sc,TweenInfo.new(0.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play() end
 task.delay(3,function() if toast.Parent then toast.Visible=false end end)
end
local function refreshCash() cashCounter.Amount.Text=fmt(cash.Value) end
local function refreshFood() foodCounter.Amount.Text=fmt(inventory.Value).." / "..fmt(capacity and capacity.Value or 250).." FOOD" end
refreshCash(); refreshFood()
cash.Changed:Connect(refreshCash); inventory.Changed:Connect(refreshFood)
if capacity then capacity.Changed:Connect(refreshFood) end
local allWindows={}
for _,name in ipairs({"RewardsWindow","CodesWindow","DailyWindow","TimeWindow"}) do
 local w=windows:FindFirstChild(name); if w then table.insert(allWindows,w) end
end
local sellWindow=windows:WaitForChild("CodesWindow"):Clone()
sellWindow.Name="SellWindow"
sellWindow.Visible=false
sellWindow.Parent=windows
local sellBody=sellWindow:WaitForChild("Body")
sellBody:WaitForChild("CodeBoxFrame").Visible=false
sellBody:WaitForChild("Message").Text="Sell all food in your inventory for Cash. You must be at the Sell Shop counter."
sellBody:WaitForChild("Status").Visible=true
sellBody.Status.Text=""
sellBody.RedeemButton.Label.Text="SELL ALL"
sellWindow.Header.Title.Text="SELL FOOD"
sellWindow.Header.TitleShadow.Text="SELL FOOD"
table.insert(allWindows,sellWindow)
local function closeAll()
 for _,w in ipairs(allWindows) do w.Visible=false end
 shop.Visible=false
 local sf=shop:FindFirstChild("Frame"); if sf then sf.Visible=false end
 settings.Visible=false
 local st=settings:FindFirstChild("Frame"); if st then st.Visible=false end
end
local function openWindow(name)
 closeAll()
 local w=windows:FindFirstChild(name)
 if w then w.Visible=true end
end
local function bindHit(parent,callback)
 if not parent then return end
 local target=parent:FindFirstChild("HitTarget")
 if target and target:IsA("GuiButton") then target.Activated:Connect(callback) end
end
local function bindClose(w)
 local h=w and w:FindFirstChild("Header")
 local c=h and h:FindFirstChild("CloseButton")
 bindHit(c,function() w.Visible=false end)
end
for _,w in ipairs(allWindows) do bindClose(w) end

-- Main navigation uses the UIverse left-hand menu.
bindHit(left:FindFirstChild("ShopButton"),function()
 closeAll(); shop.Visible=true; local f=shop:FindFirstChild("Frame"); if f then f.Visible=true end
 ReplicatedStorage:WaitForChild("LickMenu"):Fire("shop")
end)
bindHit(left:FindFirstChild("RewardsButton"),function()
 openWindow("RewardsWindow")
end)
bindHit(left:FindFirstChild("DailyButton"),function()
 openWindow("DailyWindow")
end)
bindHit(left:FindFirstChild("CodesButton"),function()
 openWindow("CodesWindow")
end)
bindHit(left:FindFirstChild("LuckyWheelButton"),function()
 openWindow("SellWindow")
end)
bindHit(left:FindFirstChild("TimeButton"),function()
 openWindow("TimeWindow")
end)
local setHit=hud:FindFirstChild("SettingsButton")
bindHit(setHit,function()
 closeAll(); settings.Visible=true; local f=settings:FindFirstChild("Frame"); if f then f.Visible=true end
end)
local function bindImageClose(root)
 local b=root and root:FindFirstChild("Close",true)
 if b and b:IsA("GuiButton") then b.Activated:Connect(function() root.Visible=false end) end
end
bindImageClose(shop:FindFirstChild("Frame")); bindImageClose(settings:FindFirstChild("Frame"))
local closeShop=shop:FindFirstChild("Close",true)
if closeShop and closeShop:IsA("GuiButton") then closeShop.Activated:Connect(function() shop.Visible=false end) end

-- UIverse right-side cards are wired to actual LickLand actions (no kit economy).
local offers=hud:WaitForChild("RightOffers")
bindHit(offers:FindFirstChild("SpinsOffer"),function()
 closeAll()
 remotes.Rebirth:FireServer()
end)
bindHit(offers:FindFirstChild("SecretPackOffer"),function()
 local zone=tonumber(player:GetAttribute("BestZone")) or 1
 remotes.Teleport:FireServer(zone)
end)
bindHit(offers:FindFirstChild("CashOffer"),function()
 closeAll(); shop.Visible=true; local f=shop:FindFirstChild("Frame"); if f then f.Visible=true end
 ReplicatedStorage:WaitForChild("LickMenu"):Fire("shop")
end)

-- Existing Cash upgrades, restyled with UIverse Money cards.
local shopFrame=shop:WaitForChild("Frame")
local scrolling=shopFrame:WaitForChild("ScrollingFrame")
local money=scrolling:WaitForChild("Money")
local upgradeMap={{"c1","speed","SpeedCost"},{"c2","lickspeed","LickSpeedCost"},{"c3","lucky","LuckyCost"}}
for _,row in ipairs(upgradeMap) do
 local card=money:FindFirstChild(row[1]); local btns=card and card:FindFirstChild("Btns")
 local buy=btns and btns:FindFirstChild("Buy")
 local function update()
  local cost=player:GetAttribute(row[3]) or 0
  local price=buy and buy:FindFirstChild("Price")
  if price and price:IsA("TextLabel") then price.Text=cost&gt;0 and ("BUY · "..fmt(cost)) or "MAX" end
 end
 update(); player:GetAttributeChangedSignal(row[3]):Connect(update)
 if buy and buy:IsA("GuiButton") then buy.Activated:Connect(function()
  remotes.BuyUpgrade:FireServer(row[2]); showToast("Upgrade purchase requested")
 end) end
end

-- Code redemption is handled by the existing secure server function.
do
 local w=windows:WaitForChild("CodesWindow"); local body=w:WaitForChild("Body")
 local btn=body.RedeemButton:WaitForChild("HitTarget")
 btn.Activated:Connect(function()
  local code=body.CodeBoxFrame.CodeBox.Text
  if code=="" then body.Status.Visible=true; body.Status.Text="Enter a code first."; return end
  local ok,msg=pcall(function() return remotes.RedeemCode:InvokeServer(code) end)
  body.Status.Visible=true
  body.Status.Text=ok and tostring(msg or "") or "Code service is unavailable."
 end)
end

-- Daily reward: any visible day card invokes the existing once-per-day claim guard.
do
 local w=windows:WaitForChild("DailyWindow")
 local body=w:WaitForChild("Body")
 for _,slot in ipairs(body:GetChildren()) do
  if slot:IsA("Frame") and string.match(slot.Name,"^Slot%d+$") then
   local hit=slot:FindFirstChild("HitTarget",true)
   if hit and hit:IsA("GuiButton") then hit.Activated:Connect(function() remotes.ClaimLogin:FireServer() end) end
  end
 end
 local title=w.Header:FindFirstChild("Title"); if title then title.Text="DAILY REWARDS" end
 local shadow=w.Header:FindFirstChild("TitleShadow"); if shadow then shadow.Text="DAILY REWARDS" end
end

-- Free gift uses LickLand's cooldown-checked gift remote (not the kit's reward backend).
do
 local w=windows:WaitForChild("RewardsWindow"); local body=w:WaitForChild("Body")
 body.Message.Text="Claim a free Cash gift when your cooldown is ready."
 body.RewardCard.CashAmount.Text="FREE CASH"
 body.RewardCard.SpinAmount.Visible=false; body.RewardCard.SpinIcon.Visible=false
 body.JoinGroupButton.Label.Text="CLAIM FREE GIFT"
 bindHit(body.JoinGroupButton,function() remotes.Free:FireServer() end)
 w.Header.Title.Text="FREE GIFT"; w.Header.TitleShadow.Text="FREE GIFT"
end

-- Daily and weekly quests are read from the player's replicated quest state.
local questMap={}
local questBody=windows:WaitForChild("TimeWindow"):WaitForChild("Body")
for i=1,7 do
 local slot=questBody:FindFirstChild("Slot"..i)
 local status=slot and slot:FindFirstChild("StatusButton")
 local hit=status and status:FindFirstChild("HitTarget")
 if hit and hit:IsA("GuiButton") then
  hit.Activated:Connect(function()
   local item=questMap[i]
   if item and not item.q.claimed and (item.q.n or 0)&gt;=(item.q.target or 1) then
    remotes.QuestClaim:FireServer(item.id)
   else
    showToast("Keep progressing on this quest")
   end
  end)
 end
end
local function refreshQuests()
 local w=windows:WaitForChild("TimeWindow"); local body=w:WaitForChild("Body")
 local qval=state:FindFirstChild("Quests")
 local ok,data=pcall(function() return qval and game:GetService("HttpService"):JSONDecode(qval.Value) or {} end)
 data=ok and type(data)=="table" and data or {}
 local tasks={}
 for _,cat in ipairs({"d","w"}) do
  local pack=data[cat]
  if pack and type(pack.list)=="table" then
   for i,q in ipairs(pack.list) do tasks[#tasks+1]={id=cat..i,q=q} end
  end
 end
 for i=1,7 do
  local slot=body:FindFirstChild("Slot"..i)
  if slot then
   local item=tasks[i]
   if item then
    local q=item.q
    local t=slot:FindFirstChild("Title"); if t then t.Text=(i&lt;=3 and "DAILY" or "WEEKLY").." QUEST "..tostring(i&lt;=3 and i or i-3) end
    local word=slot:FindFirstChild("Word"); if word then word.Text=tostring(q.desc or "Quest").."  "..tostring(q.n or 0).."/"..tostring(q.target or 0) end
    local status=slot:FindFirstChild("StatusButton")
    local lab=status and status:FindFirstChild("Label")
    if lab then lab.Text=q.claimed and "CLAIMED" or ((q.n or 0)&gt;=(q.target or 1) and "CLAIM" or "IN PROGRESS") end
    questMap[i]=item
    slot.Visible=true
   else questMap[i]=nil; slot.Visible=false end
  end
 end
 local title=w.Header:FindFirstChild("Title"); if title then title.Text="QUESTS" end
 local shadow=w.Header:FindFirstChild("TitleShadow"); if shadow then shadow.Text="QUESTS" end
end
refreshQuests()
task.spawn(function()
 local questState=state:WaitForChild("Quests",30)
 if questState then questState.Changed:Connect(refreshQuests); refreshQuests() end
end)

-- Sell panel only appears from the Sell Shop prompt or the left menu; the server enforces proximity.
do
 local button=sellBody.RedeemButton:WaitForChild("HitTarget")
 button.Activated:Connect(function()
  local ok,a,b=pcall(function() return remotes.SellFood:InvokeServer() end)
  if not ok then sellBody.Status.Text="Sell service is unavailable."; return end
  if a then
   sellBody.Status.Text="SOLD! +"..fmt(b or 0).." CASH"
   showToast("Food sold for Cash")
  else sellBody.Status.Text=tostring(b or "Move closer to the Sell Shop.") end
 end)
 remotes.OpenSellShop.OnClientEvent:Connect(function()
  openWindow("SellWindow")
  sellBody.Status.Text="Ready to sell: "..fmt(inventory.Value).." food"
 end)
end

remotes.Notify.OnClientEvent:Connect(function(msg) showToast(msg) end)
-- Rebuild lightweight scale responsiveness without changing the supplied art.
local scale=hud:FindFirstChild("HUDScale")
local function fit()
 if not scale or not workspace.CurrentCamera then return end
 scale.Scale=math.clamp(workspace.CurrentCamera.ViewportSize.Y/760,0.62,1.12)
end
fit()
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end

